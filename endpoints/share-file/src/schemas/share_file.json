{
  "definitions": {}, 
  "$schema": "http://json-schema.org/draft-07/schema#", 
  "type": "object", 
  "title": "Share File Schema", 
  "required": [
    "share_with"
  ],
  "properties": {
    "share_with": {
      "$id": "#/properties/share_with", 
      "type": "array",
      "title": "The list of emails with who you want to share your file", 
      "examples": [
	      ["42@42.com"]
      ]
    },
    "expires_in": {
      "$id": "#/properties/expires_in",
      "title": "How long the link works: seconds (900, 3600, 21600, 86400, 604800) or \"never\"",
      "type": ["integer", "string"],
      "examples": [3600, "never"]
    }
  },
  "additionalProperties": false
}
