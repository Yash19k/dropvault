{
  "definitions": {},
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "New File Schema",
  "required": [
    "file_name"
  ],
  "properties": {
    "file_name": {
      "$id": "#/properties/file_name",
      "type": "string",
      "title": "The name under which you want to store your file",
      "examples": ["report.pdf"]
    },
    "content_type": {
      "$id": "#/properties/content_type",
      "type": "string",
      "title": "The MIME type of the file (used for the presigned upload and downloads)",
      "examples": ["application/pdf"]
    },
    "size": {
      "$id": "#/properties/size",
      "type": "integer",
      "title": "The size of the file in bytes",
      "minimum": 0,
      "examples": [1048576]
    }
  },
  "additionalProperties": false
}
