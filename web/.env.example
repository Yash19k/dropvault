# Enclave is wired to its backend microservices at BUILD time. Copy to .env.local
# for local dev, or set these in your CI/build before `npm run build`.

# CognitoApi (the auth/authorization microservice you deploy first)
VITE_AUTH_URL=https://auth.example.com

# Enclave File API (from `cd ../terraform && make output`)
# Omit if the File API lives behind the same gateway as auth.
VITE_FILE_URL=https://files.example.com
