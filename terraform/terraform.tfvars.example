# Copy to terraform.tfvars and fill in. deploy.sh (and `make apply`) read terraform.tfvars.

aws_region  = "ap-south-1"
aws_profile = "" # e.g. "my-aws-profile"; empty = default credential chain

app_name    = "enclave"
environment = "dev"

# --- Auth ---
# Empty = built-in simple email+password auth service (auth.tf) on the same API.
# Or set the base URL of an external auth microservice (e.g. CognitoApi).
auth_endpoint = ""

# --- Email sharing (Amazon SES) ---
# Share emails are sent FROM this address. AWS emails it a verification link on
# first deploy - click it. New accounts are in the SES sandbox (can only send to
# verified addresses) until you request production access.
sender_email = "you@example.com"
# sender_ses_arn = ""   # optional: an already-verified SES identity ARN

# --- Storage (optional; default bucket name is <app>-<env>-files-<account id>) ---
# files_bucket_name = "my-globally-unique-bucket"
# table_name        = "enclave-files-dev"

# --- Web hosting: "amplify" (works on new accounts) or "cloudfront"
#     (new AWS accounts must be verified by AWS Support before using CloudFront)
web_hosting = "amplify"

# --- Extra origins allowed to upload/download directly to S3 (the hosted app is always allowed)
allowed_origins = ["http://localhost:3001"]

# --- Custom API domain (optional; DropVault creates its OWN ACM cert in this zone) ---
api_domain_name = "" # e.g. "files.example.com"; empty = default execute-api URL
route53_zone_id = "" # required when api_domain_name is set

# --- Storage each user may use, in bytes. 0 = unlimited. (10 GiB = 10737418240)
user_quota_bytes = 10737418240

# --- Admin panel (/admin): accounts with these emails are owner admins. Sign up
#     with one of them, then open the admin panel; you can make others admins there.
admin_emails = [] # e.g. ["you@example.com"] (lowercase)

# --- Alerts: emails for errors in the logs, health check problems, CloudWatch
#     alarms and failed deploys. AWS sends a confirmation link to this address
#     first. Empty = no email.
alert_email            = ""
health_check_minutes   = 5        # 0 = no scheduled health check
alert_cooldown_minutes = 15       # at most one error email per function in this time
alert_utc_offset       = "+00:00" # time zone of the times in alert emails, e.g. "+05:30"

# --- Encryption: 's3' (free), 'shared' (one KMS key), or 'per_user' (~$1/user/mo) ---
kms_mode = "s3"

# --- Build tooling ---
# Linux/macOS defaults: bash_bin = "/bin/bash", python_bin = "python3"
# Windows (Git Bash):
# bash_bin   = "C:/Program Files/Git/bin/bash.exe"
# python_bin = "python"
